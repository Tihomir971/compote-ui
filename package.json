{
	"name": "compote-ui",
	"version": "0.70.0",
	"license": "MIT",
	"scripts": {
		"dev": "vite dev --open",
		"build": "vite build && npm run prepack",
		"build:docs": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"patch": "npm version patch && npm publish",
		"minor": "npm version minor && npm publish"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"skills",
		"!skills/_artifacts"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./data-table": {
			"types": "./dist/components/data-table-v9/index.d.ts",
			"svelte": "./dist/components/data-table-v9/index.js"
		},
		"./data-table/virtual": {
			"types": "./dist/components/data-table-v9/virtual/index.d.ts",
			"svelte": "./dist/components/data-table-v9/virtual/index.js"
		},
		"./theme.css": "./dist/theme.css"
	},
	"peerDependencies": {
		"@tanstack/svelte-table": ">=9.0.0-beta.38 <10",
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"@tanstack/svelte-table": {
			"optional": true
		}
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@faker-js/faker": "^10.5.0",
		"@iconify-json/ph": "^1.2.2",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/intent": "^0.3.6",
		"@tanstack/svelte-table": "9.0.0",
		"@types/node": "^22.20.0",
		"eslint": "^10.8.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.23",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"unplugin-icons": "^23.0.1",
		"vite": "^8.2.0"
	},
	"keywords": [
		"svelte",
		"tanstack-intent"
	],
	"dependencies": {
		"@ark-ui/svelte": "^5.23.0",
		"@fontsource-variable/nunito-sans": "^5.2.7",
		"@internationalized/date": "^3.12.3",
		"@tanstack/svelte-virtual": "^3.13.35",
		"runed": "^0.37.1",
		"svelte-tel-input": "^4.3.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1"
	},
	"intent": {
		"skills": [
			"compote-ui",
			"@tanstack/svelte-table"
		]
	}
}
